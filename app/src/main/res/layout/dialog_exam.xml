<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📝 Nuevo Examen"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1F1F1F"
            android:layout_marginBottom="16dp"/>

        <!-- Título del Examen -->
        <EditText
            android:id="@+id/etExamTitle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Título (ej. Examen de Matemáticas)"
            android:textSize="16sp"
            android:textColor="#1F1F1F"
            android:background="@android:color/transparent"
            android:paddingBottom="12dp"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp"/>

        <!-- Asignatura -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="📚 Asignatura"
                android:textColor="#555555"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/etExamSubject"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ej. Matemáticas"
                android:textSize="14sp"
                android:textColor="#1F1F1F"/>
        </LinearLayout>

        <!-- Aula -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="🚪 Aula"
                android:textColor="#555555"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/etExamClassroom"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ej. Aula 203"
                android:textSize="14sp"
                android:textColor="#1F1F1F"/>
        </LinearLayout>

        <!-- Fecha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="📅 Fecha"
                android:textColor="#555555"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/etExamDate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ej. 22 de mayo"
                android:textSize="14sp"
                android:textColor="#1F1F1F"/>
        </LinearLayout>

        <!-- Días restantes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="⏳ Días Restantes"
                android:textColor="#555555"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/etExamDaysRemaining"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ej. En 5 días"
                android:textSize="14sp"
                android:textColor="#1F1F1F"/>
        </LinearLayout>

        <!-- Personalización: Emoji -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="🎨 Emoji"
                android:textColor="#555555"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/etExamEmoji"
                android:layout_width="80dp"
                android:layout_height="48dp"
                android:hint="📊"
                android:gravity="center"
                android:textSize="20sp"
                android:maxLength="2"/>
        </LinearLayout>

        <!-- Personalización: Color de Fondo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="🎨 Color"
                android:textColor="#555555"
                android:textStyle="bold"/>
            <Spinner
                android:id="@+id/spinnerExamColor"
                android:layout_width="match_parent"
                android:layout_height="48dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>